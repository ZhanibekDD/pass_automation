# AI выключен по умолчанию. Включайте только после запуска локальной модели.
AI_ENABLED=false

# ollama | vllm
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434
AI_VISION_MODEL=qwen2.5vl:7b

# Необязательный локальный ключ для защиты Pass Docs AI API.
# Значения здесь намеренно пустые; секреты задаются только в локальном .env.
AI_API_KEY=

# Отдельный Bearer token для OpenAI-compatible vLLM, если сервер его требует.
AI_MODEL_API_KEY=

# Отдельная локальная БД AI. Production-БД Pass Docs не используется.
AI_DATABASE_PATH=data/ai/pass_docs_ai.sqlite3
AI_INPUT_JSON=data/input/package_input.json

# Политики проверки (коды из app/constants/doc_catalog.py).
AI_REQUIRED_DOCUMENT_CODES=6,7,44,45,52
AI_DATED_DOCUMENT_CODES=6,7,13,14,19,26,37,43,44,57,61,63,64,65,66,67
AI_CONFIDENCE_THRESHOLD=0.75

# Лимиты для защиты локального сервиса.
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_FILE_SIZE_MB=20
AI_MAX_PAGES=20
AI_RENDER_DPI=160
AI_MAX_IMAGE_DIMENSION=2200
AI_API_PORT=8090
