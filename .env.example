# AI выключен по умолчанию. Включайте только после запуска локальной модели.
AI_ENABLED=false

# ollama | vllm
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434

# Модель НЕ зашита в коде — задаётся здесь.
# Staging (Ollama): qwen2.5vl:7b или qwen2.5vl:32b (для A40 48GB)
# Production (vLLM): Qwen/Qwen2.5-VL-7B-Instruct или Qwen/Qwen2.5-VL-32B-Instruct
AI_VISION_MODEL=qwen2.5vl:7b

# ─── RBAC токены ──────────────────────────────────────────────────────────────
# Задайте разные токены для каждой роли. Значения здесь намеренно пусты.
# Минимум: задайте AI_TOKEN_REVIEWER и AI_TOKEN_ADMIN.
# Альтернатива: укажите AI_TOKEN_FILE=/etc/pass-docs-ai/tokens.json
AI_TOKEN_VIEWER=
AI_TOKEN_OPERATOR=
AI_TOKEN_REVIEWER=
AI_TOKEN_ADMIN=

# Файл токенов (приоритет над AI_TOKEN_* переменными)
# Формат: [{"token": "raw", "role": "reviewer", "description": "..."}]
AI_TOKEN_FILE=

# ─── База данных AI (отдельная от production) ─────────────────────────────────
# AI использует изолированную SQLite с WAL (shadow mode, production-БД не трогает).
AI_DATABASE_PATH=data/ai/pass_docs_ai.sqlite3
AI_INPUT_JSON=data/input/package_input.json

# ─── Политики проверки (коды документов) ──────────────────────────────────────
AI_REQUIRED_DOCUMENT_CODES=6,7,44,45,52
AI_DATED_DOCUMENT_CODES=6,7,13,14,19,26,37,43,44,57,61,63,64,65,66,67
AI_CONFIDENCE_THRESHOLD=0.75

# Транспорт: обязательные и датированные документы
AI_REQUIRED_VEHICLE_DOC_CODES=registration,insurance,inspection
AI_DATED_VEHICLE_DOC_CODES=insurance,inspection,power_of_attorney,vehicle_pass

# ─── DAS HTTP adapter (AI_DATA_ADAPTER=das) ───────────────────────────────────
# Для подключения к DAS сервер нужно развернуть deploy/das/adminpanel_ai_api.py
# и задать AI_INTERNAL_TOKEN на стороне DAS.
AI_DATA_ADAPTER=json
AI_DAS_BASE_URL=http://localhost:8000
AI_DAS_TOKEN=

# ─── Лимиты безопасности ──────────────────────────────────────────────────────
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MAX_FILE_SIZE_MB=20
AI_MAX_PAGES=20
AI_RENDER_DPI=160
AI_MAX_IMAGE_DIMENSION=2200
AI_API_PORT=8090

# ─── vLLM (production) ────────────────────────────────────────────────────────
# Bearer token для OpenAI-compatible vLLM (если требуется)
AI_MODEL_API_KEY=

# GPU (для docker-compose.production.yml)
# Узнать UUID: nvidia-smi --query-gpu=uuid --format=csv,noheader
NVIDIA_GPU_UUID=0

# HuggingFace token (для загрузки моделей через vLLM)
HF_TOKEN=
