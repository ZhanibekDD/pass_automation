FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

COPY requirements-ai.txt ./
RUN pip install --no-cache-dir -r requirements-ai.txt

COPY app ./app
COPY scripts ./scripts

RUN useradd --create-home --uid 10001 passai \
    && mkdir -p /workspace/data/ai /workspace/data/input \
    && chown -R passai:passai /workspace

USER passai

EXPOSE 8090

CMD ["uvicorn", "app.ai.api:app", "--host", "0.0.0.0", "--port", "8090"]
